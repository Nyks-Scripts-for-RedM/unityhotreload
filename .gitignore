# =====================================================================
# Unity Package Manager (UPM) Repository .gitignore
# IMPORTANT: .meta files MUST be tracked in a UPM package repository!
# =====================================================================

# Never ignore Unity .meta files in UPM packages
!*.meta

# Local internal documentation (never pushed to public repo)
SOURCE_OF_TRUTH.md
SOURCE_OF_TRUTH.md.meta

# Temporary compilation & Hot Reload scratch folders
Temp/
obj/
bin/
Logs/
UserSettings/
MemoryCaptures/
Recordings/
HotReloadTemp/
*.HotReloadPatch.dll
*.HotReloadPatch.pdb
*.rsp

# IDE & Editor folders
.vs/
.vscode/
.idea/
.utmp/
*.csproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
